# Copier en .env.local (non versionné).
# Sur un téléphone, remplacer 127.0.0.1 par l'IP locale du PC (ex. 192.168.1.20).
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
EXPO_PUBLIC_SUPABASE_ANON_KEY=<PUBLISHABLE_KEY affichée par `npx supabase status`>

# Pages légales liées sous les boutons de connexion [À FOURNIR].
EXPO_PUBLIC_TERMS_URL=https://exemple.fr/conditions
EXPO_PUBLIC_PRIVACY_URL=https://exemple.fr/confidentialite
